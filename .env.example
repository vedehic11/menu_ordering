# PostgreSQL connection URL. For production, use a managed persistent database
# and require TLS. Replace every placeholder with the values from your provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Public origin used in staff PIN setup emails.
# Use the deployed HTTPS origin in production (for example https://orders.example.com).
NEXT_PUBLIC_APP_URL=""

# Resend credentials for staff invitations and PIN setup/reset links.
# Verify the sender domain with Resend before using it.
RESEND_API_KEY=""
EMAIL_FROM=""

# Generate a unique secret for this deployment with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Keep it stable between restarts; changing it invalidates existing staff sessions.
STAFF_JWT_SECRET=""

# Used only by the initial production seed. Choose an owner contact email and a
# unique PIN of at least 8 digits; remove INITIAL_OWNER_PIN after seeding.
INITIAL_OWNER_NAME="Restaurant Owner"
INITIAL_OWNER_EMAIL=""
INITIAL_OWNER_PIN=""

# Absolute path mounted on durable storage by the production host, shared by
# every application instance (for example /mnt/restaurant-uploads).
UPLOADS_DIR=""
